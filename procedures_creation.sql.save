kevin@dbpostgre:~/novabank$ sudo -u postgres psql -d bankdb -c "\d core.ecritures"
                                     Table "core.ecritures"
     Column     |           Type           | Collation | Nullable |           Default
----------------+--------------------------+-----------+----------+------------------------------
 ecriture_id    | bigint                   |           | not null | generated always as identity
 compte_id      | bigint                   |           | not null |
 virement_id    | bigint                   |           |          |
 type           | core.type_ecriture       |           | not null |
 montant        | numeric(14,2)            |           | not null |
 balance_after  | numeric(14,2)            |           | not null |
 date_operation | timestamp with time zone |           | not null |
Indexes:
    "ecritures_pkey" PRIMARY KEY, btree (ecriture_id)
    "idx_ecritures_brin_date" brin (date_operation)
    "idx_ecritures_compte_date" btree (compte_id, date_operation DESC)
Check constraints:
    "ck_ecritures_balance_positive" CHECK (balance_after >= 0::numeric)
Foreign-key constraints:
    "ecritures_compte_id_fkey" FOREIGN KEY (compte_id) REFERENCES core.comptes(compte_id)
    "ecritures_virement_id_fkey" FOREIGN KEY (virement_id) REFERENCES core.virements(virement_id)
Triggers:
    trg_ecritures_no_truncate BEFORE TRUNCATE ON core.ecritures FOR EACH STATEMENT EXECUTE FUNCTION core.fn_prevent_ledger_alteration()
    trg_ecritures_no_update_delete BEFORE DELETE OR UPDATE ON core.ecritures FOR EACH ROW EXECUTE FUNCTION core.fn_prevent_ledger_alteration()
    trg_ecritures_process_balance BEFORE INSERT ON core.ecritures FOR EACH ROW EXECUTE FUNCTION core.fn_process_account_balance()

